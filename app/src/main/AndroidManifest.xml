<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KafePastry"
        tools:targetApi="31">

        <!-- 1. Splash Activity (Halaman pertama saat aplikasi dibuka) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- 3. Register / SignUp Activity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false" />

        <!-- 4. MainActivity (Halaman Utama / Home Menu) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 5. Profile Activity (Halaman Edit Profil & Logout) -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- 6. Order Activity (Halaman Form Pengiriman) -->
        <activity
            android:name=".OrderActivity"
            android:exported="false" />

        <!-- 7. Success Activity (Halaman Konfirmasi Pesanan Berhasil) -->
        <activity
            android:name=".SuccessActivity"
            android:exported="false" />

    </application>

</manifest>